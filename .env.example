# Copy to .env and adjust. Loaded automatically by `npm start`.

# Only listen on this computer (recommended). Use 0.0.0.0 only behind HTTPS.
HOST=127.0.0.1
PORT=3000

# Admin password for the web UI. If unset, one is generated on first start and printed.
# ADMIN_PASSWORD=change-me-to-something-long

# Key used to encrypt saved server credentials. If unset, one is generated in data/config.json.
# SERVERBOY_SECRET=

# DATA_DIR=./data
# TRUST_PROXY=1
